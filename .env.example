# Vigil Protection RPC configuration
PROTECTION_RPC_PORT=8899
RUST_LOG=info

# Helius RPC (replace YOUR_API_KEY)
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY
SOLANA_SEND_TX_URL=https://staked-mainnet.helius-rpc.com/?api-key=YOUR_API_KEY

# Sandwich protection engine
# permissive: log/measure only, never refuse a tx
# strict: return JSON-RPC error when risk level reaches BLOCK
BLOCK_MODE=permissive

# Slot watcher (background sandwich learner)
SLOT_POLL_INTERVAL_SECS=10
SLOT_WATCHER_LAG=32

# Risk map sizing
POOL_LRU_CAPACITY=1024
ATTACKER_LRU_CAPACITY=1024
POOL_TTL_SECS=86400
